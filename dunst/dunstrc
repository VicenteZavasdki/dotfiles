# Dunst Notification Daemon Config - Catppuccin Mocha

[global]
font = JetBrains Mono 11
icon_path = /usr/share/icons/Papirus-Dark
frame_width = 0
frame_padding = 8
inner_padding = 8
max_icon_size = 48
separator_color = #45475a
text_icon_padding = 8

[urgency_low]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#45475a"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#45475a"

[urgency_critical]
background = "#1e1e2e"
foreground = "#f38ba8"
frame_color = "#f38ba8"

[shortcuts]
close = ctrl+shift+close
do_action = ctrl+shift+do
open_url = ctrl+shift+open_url