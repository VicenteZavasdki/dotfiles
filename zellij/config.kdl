// Zellij Config - Zavasdki Setup

theme "dracula"

theme_overrides {
    bg_parallel 1e1e2e
    fg cd d6f4
    black 45475a
    red f38ba8
    green a6e3a1
    yellow f9e2af
    blue 89b4fa
    magenta f5c2e7
    cyan 94e2d5
    orange fab387
}

ui {
    pane_frames false
    theme_ascii_height u1
    theme_ascii_top_left '['
    theme_ascii_top_right ']'
    theme_ascii_bottom_left '['
    theme_ascii_bottom_right ']'
}

keybindings {
    unbind 'Ctrl g'
    unbind 'Ctrl q'
}