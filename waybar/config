{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 2,
    "modules-left": ["sway/workspaces", "cpu", "memory"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{icon}"
    },

    "cpu": {
        "format": "󰻷 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰾆 {used:0.1f}G",
        "interval": 2,
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "{:%Y-%m-%d | %H:%M}",
        "interval": 1
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀",
        "tooltip-format": "{ifname} - {ipaddr}",
        "interval": 5
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰊠",
            "headset": "󰋎",
            "phone": "󰏎",
            "portable": "󰏎",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "interval": 1
    },

    "tray": {
        "spacing": 8
    }
}